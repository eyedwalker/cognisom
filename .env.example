# Cognisom HDT Platform — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Development Mode ─────────────────────────────────────────────
# Set to true to bypass tier checks. Local development only: the bypass
# refuses to engage when Cognito is configured, but a template should not
# ship with it on.
COGNISOM_DEV_MODE=false

# ── NVIDIA NIM API ───────────────────────────────────────────────────
# Get your key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NGC_API_KEY=your-ngc-key-here

# ── Flask API ────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-string
FLASK_DEBUG=false
PORT=5000

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8501,http://localhost:8080

# ── Auth ─────────────────────────────────────────────────────────────
# Directory for user/session JSON storage
COGNISOM_AUTH_DIR=data/auth

# ── AWS Cognito (Production Only) ────────────────────────────────────
# Leave commented out for local development
# COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
# AWS_REGION=us-east-1

# ── Database (Production Only) ───────────────────────────────────────
# Leave commented out to use local SQLite/JSON
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Investor data room ───────────────────────────────────────────────
# Access code for the investor page. When unset the page stays closed
# rather than falling back to a shared default.
# COGNISOM_INVESTOR_CODE=

# ── Neoantigen binding predictor ─────────────────────────────────────
# MHCflurry is a hard dependency (see requirements.txt) and is expected to
# be importable. If it is not, prediction raises rather than silently
# downgrading. Set this to run anyway with the approximate position-weight
# -matrix scorer: its affinities are quantised to a few values and it can
# never report a strong binder (its floor is 52.8 nM vs a 50 nM threshold),
# so results are not publication grade.
# Note: mhcflurry 2.0.6 needs Python <= 3.12; on 3.13 it cannot import.
# COGNISOM_ALLOW_PWM_FALLBACK=1
