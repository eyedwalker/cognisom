# Cognisom HDT Platform — Production image
# Runs both Flask API (gunicorn) + Streamlit dashboard
# No GPU required — simulation is pure NumPy/SciPy

FROM python:3.11-slim

# Build args for versioning
ARG COGNISOM_GIT_SHA=dev
ARG COGNISOM_BUILD_DATE=unknown
ARG COGNISOM_VERSION=0.3.0

# Set as environment variables for runtime
ENV COGNISOM_GIT_SHA=$COGNISOM_GIT_SHA
ENV COGNISOM_BUILD_DATE=$COGNISOM_BUILD_DATE
ENV COGNISOM_VERSION=$COGNISOM_VERSION

WORKDIR /app

# System dependencies (igraph needs cmake, flex, bison for building)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc g++ git curl cmake \
        flex bison libxml2-dev \
        libxrender1 libxext6 libsm6 && \
    rm -rf /var/lib/apt/lists/*

# Python dependencies.
# Kept as its own RUN so a failure here fails the build. Previously this was
# chained with `... || true`, which swallowed errors from the requirements
# install itself, not just the optional package that followed it.
#
# pip is upgraded FIRST, and that line is what makes this image buildable at
# all. python:3.11-slim bundles pip 24.0, whose resolver cannot solve this
# file: measured 2026-11-06, it walked scikit-image backwards (0.25.2 ->
# 0.25.1 -> 0.25.0 -> 0.24.0, ~36 min per version) and died after 2 h 26 m
# with `resolvelib.resolvers.ResolutionTooDeep: 200000`.
#
# The requirement set is NOT in conflict. The CI `test` job installs this
# same requirements.txt on the same python 3.11 / linux x86_64 in 89
# SECONDS -- numpy 1.26.4, scikit-image 0.26.0, tensorflow-cpu 2.15.1 --
# because actions/setup-python ships pip 26.2.2. The difference was never
# the dependencies; it was the resolver. Every build-and-push since
# then failed at this step, which is why no image reached ECR after
# 2026-09-08 and `deploy-apps-server.sh --pull <sha>` had nothing to pull.
#
# Pinned rather than `--upgrade pip`: 26.2.2 is the version measured to
# resolve this file, and a floating pip would make whether the image builds
# depend on whichever pip ships the day someone builds it.
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip==26.2.2 \
 && pip install --no-cache-dir -r requirements.txt

# NO rdkit-pypi install here, deliberately.
#
# requirements.txt declares the official `rdkit` distribution and says why:
# rdkit-pypi was the unofficial build from before the RDKit project shipped
# its own wheels, and it stopped publishing after 2022.9.5. Installing it
# afterwards was not a harmless fallback. Its wheel ships the SAME
# top-level `rdkit/` package -- verified 2026-11-06 against
# rdkit_pypi-2022.9.5-cp311-cp311-manylinux_2_17_x86_64.whl, which has a
# cp311 linux wheel and so does install -- so it would overwrite
# site-packages/rdkit with four-year-old code while pip's own metadata went
# on reporting rdkit 2026.9.1 as the installed version.
#
# It has never actually run, because the install above has never succeeded.
# Fixing pip without deleting this would have shipped the downgrade on the
# first green build.

# Bake MHCflurry model weights into the image (~600 MB). Without this the
# first prediction would download them at runtime, or fail closed.
#
# MHCFLURRY_DATA_DIR is set explicitly, and matters: this RUN executes as
# root, while the container runs as the unprivileged `cognisom` user (below).
# Left to the default of ~/.local/share/mhcflurry the weights would land in
# /root and be invisible at runtime, so every prediction would raise. The
# directory is world-readable so any runtime user can load the models.
ENV MHCFLURRY_DATA_DIR=/opt/mhcflurry
RUN mhcflurry-downloads fetch models_class1_presentation \
    && chmod -R a+rX /opt/mhcflurry

# Application code
COPY . .

# Create data directories
RUN mkdir -p data/auth \
             data/scrna \
             data/research_cache \
             data/subscriptions \
             data/flywheel \
             data/feedback \
             data/agent_interactions \
             data/model_registry \
             data/distilled_models \
             data/calibration \
             exports

# Non-root user for security
RUN groupadd -r cognisom && useradd -r -g cognisom -d /app cognisom && \
    chown -R cognisom:cognisom /app
USER cognisom

# Fail the build, not production, if the shipped image cannot actually
# predict. Runs AS the unprivileged runtime user, so it verifies the thing
# that matters: that MHCflurry's weights are readable from the account the
# container runs under, and that the Flask app imports at the module path
# entrypoint.sh hands to gunicorn.
RUN python -c "\
from mhcflurry import Class1PresentationPredictor; \
p = Class1PresentationPredictor.load(); \
assert p.supported_alleles, 'MHCflurry loaded but exposes no alleles'; \
print('MHCflurry OK:', len(p.supported_alleles), 'alleles')" \
 && python -c "\
import cognisom.api.rest_server as a; \
assert hasattr(a, 'app'), 'gunicorn target cognisom.api.rest_server:app missing'; \
print('Flask app OK')"

# Expose both services
EXPOSE 5000 8501

# Health check on Flask API
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5000/api/health || exit 1

# Start both services
ENTRYPOINT ["bash", "entrypoint.sh"]
