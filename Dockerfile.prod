# Cognisom HDT Platform — Production image
# Runs both Flask API (gunicorn) + Streamlit dashboard
# No GPU required — simulation is pure NumPy/SciPy

FROM python:3.11-slim

# Build args for versioning
ARG COGNISOM_GIT_SHA=dev
ARG COGNISOM_BUILD_DATE=unknown
ARG COGNISOM_VERSION=0.3.0

# Set as environment variables for runtime
ENV COGNISOM_GIT_SHA=$COGNISOM_GIT_SHA
ENV COGNISOM_BUILD_DATE=$COGNISOM_BUILD_DATE
ENV COGNISOM_VERSION=$COGNISOM_VERSION

WORKDIR /app

# System dependencies (igraph needs cmake, flex, bison for building)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gcc g++ git curl cmake \
        flex bison libxml2-dev \
        libxrender1 libxext6 libsm6 && \
    rm -rf /var/lib/apt/lists/*

# Python dependencies.
# Kept as its own RUN so a failure here fails the build. Previously this was
# chained with `... || true`, which swallowed errors from the requirements
# install itself, not just the optional package that followed it.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Genuinely optional: rdkit wheels are unavailable on some platforms.
RUN pip install --no-cache-dir rdkit-pypi \
    || echo "WARNING: rdkit-pypi unavailable; cheminformatics features disabled"

# Bake MHCflurry model weights into the image (~600 MB). Without this the
# first prediction would download them at runtime, or fail closed.
#
# MHCFLURRY_DATA_DIR is set explicitly, and matters: this RUN executes as
# root, while the container runs as the unprivileged `cognisom` user (below).
# Left to the default of ~/.local/share/mhcflurry the weights would land in
# /root and be invisible at runtime, so every prediction would raise. The
# directory is world-readable so any runtime user can load the models.
ENV MHCFLURRY_DATA_DIR=/opt/mhcflurry
RUN mhcflurry-downloads fetch models_class1_presentation \
    && chmod -R a+rX /opt/mhcflurry

# Application code
COPY . .

# Create data directories
RUN mkdir -p data/auth \
             data/scrna \
             data/research_cache \
             data/subscriptions \
             data/flywheel \
             data/feedback \
             data/agent_interactions \
             data/model_registry \
             data/distilled_models \
             data/calibration \
             exports

# Non-root user for security
RUN groupadd -r cognisom && useradd -r -g cognisom -d /app cognisom && \
    chown -R cognisom:cognisom /app
USER cognisom

# Fail the build, not production, if the shipped image cannot actually
# predict. Runs AS the unprivileged runtime user, so it verifies the thing
# that matters: that MHCflurry's weights are readable from the account the
# container runs under, and that the Flask app imports at the module path
# entrypoint.sh hands to gunicorn.
RUN python -c "\
from mhcflurry import Class1PresentationPredictor; \
p = Class1PresentationPredictor.load(); \
assert p.supported_alleles, 'MHCflurry loaded but exposes no alleles'; \
print('MHCflurry OK:', len(p.supported_alleles), 'alleles')" \
 && python -c "\
import cognisom.api.rest_server as a; \
assert hasattr(a, 'app'), 'gunicorn target cognisom.api.rest_server:app missing'; \
print('Flask app OK')"

# Expose both services
EXPOSE 5000 8501

# Health check on Flask API
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5000/api/health || exit 1

# Start both services
ENTRYPOINT ["bash", "entrypoint.sh"]
