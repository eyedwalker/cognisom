##fileformat=VCFv4.2
##reference=GRCh37
##source=cBioPortal prad_su2c_2019 data_mutations.txt
##cognisom_converter=scripts/su2c_to_vcf.py --sample SC_9184_T
##cognisom_attribution=Abida et al., PNAS 2019, PMID 31061129, 'Genomic correlates of clinical outcome in advanced prostate cancer', SU2C/PCF Dream Team; cBioPortal study prad_su2c_2019
##cognisom_data_licence=Open Data Commons Open Database License (ODbL) 1.0, http://opendatacommons.org/licenses/odbl/1.0/ -- attribution and share-alike required on derived databases. This licence governs this file, not the rest of the repository.
##cognisom_normal_evidence=The normal column carries GT 0/0 and NO read depth. The source MAF publishes Mutation_Status=Somatic against matched normal SC_9184_N but publishes no normal read counts (n_ref_count and n_alt_count are empty for every row). That 0/0 therefore ASSERTS the consortium's somatic determination; it is not read evidence held in this repository. It is what makes these calls classify as SOMATIC rather than UNKNOWN:no_matched_normal.
##cognisom_indel_depth=Several frameshift and in-frame rows carry t_alt_count=0 beside a large t_ref_count in the source, which cannot be literally true of a called variant. They are emitted as published rather than corrected.
##cognisom_indel_alleles=MAF dash alleles (insertion '-' -> A, deletion ACC -> '-') have no VCF anchor base, and this repository ships no reference genome to supply one. Indels use a placeholder N anchor. REF/ALT on those rows is NOT a usable genomic allele; AA_CHANGE carries the protein consequence and is what the engine reads.
##INFO=<ID=GENE,Number=1,Type=String,Description="Hugo symbol">
##INFO=<ID=CONSEQUENCE,Number=1,Type=String,Description="Functional consequence, mapped from MAF Variant_Classification">
##INFO=<ID=AA_CHANGE,Number=1,Type=String,Description="Protein change, verbatim from MAF HGVSp_Short">
##INFO=<ID=MAF_CLASS,Number=1,Type=String,Description="Original MAF Variant_Classification">
##INFO=<ID=MAF_HGVSP_UNUSABLE,Number=1,Type=String,Description="A CODING row whose source HGVSp_Short carries no protein consequence (the MAF *N* notation) or did not parse. Flagged only on coding classifications: on an intron or UTR that same notation is correct, not corrupt, and those rows simply carry no AA_CHANGE. Deliberately NOT used as AA_CHANGE.">
##INFO=<ID=SU2C_SOMATIC_BY_CONSORTIUM,Number=0,Type=Flag,Description="MAF Mutation_Status was Somatic">
##FORMAT=<ID=GT,Number=1,Type=String,Description="Genotype">
##FORMAT=<ID=AD,Number=R,Type=Integer,Description="Allelic depths for the ref and alt alleles">
##FORMAT=<ID=DP,Number=1,Type=Integer,Description="Read depth">
##normal_sample=SC_9184_N
##tumor_sample=SC_9184_T
